# Keep line endings consistent everywhere, so .editorconfig's `end_of_line = lf`
# holds on Windows clones and shebangs don't break.
* text=auto eol=lf
*.png binary
*.jpg binary
*.gif binary
*.pdf binary
# Fixtures are real NFO bytes; scene NFOs use CRLF and CP437.
Tests/NFOKitTests/Fixtures/** -text
